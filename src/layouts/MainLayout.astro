---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NISETA - Next-Gen Product Distribution</title>
    <meta name="description" content="NISETA is a next-gen product distribution company built for speed, precision, and global scale." />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white text-gray-900">
    <header class="border-b">
      <nav class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-xl font-bold text-[#E30613]" style="font-family: 'Archivo Black', sans-serif;">NISETA</a>
        <div class="hidden md:flex gap-6">
          <a href="/" class="hover:text-[#E30613] transition-colors duration-200">Home</a>
          <a href="/about" class="hover:text-[#E30613] transition-colors duration-200">About</a>
          <a href="/contact" class="hover:text-[#E30613] transition-colors duration-200">Contact</a>
        </div>
        <button id="menu-btn" class="md:hidden text-2xl cursor-pointer">&#9776;</button>
      </nav>
      <div id="mobile-menu" class="hidden md:hidden px-4 pb-4 flex flex-col gap-2">
        <a href="/" class="hover:text-[#E30613]">Home</a>
        <a href="/about" class="hover:text-[#E30613]">About</a>
        <a href="/contact" class="hover:text-[#E30613]">Contact</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <Footer />

    <script>
      document.getElementById('menu-btn').addEventListener('click', () => {
        document.getElementById('mobile-menu').classList.toggle('hidden');
      });
    </script>
  </body>
</html>