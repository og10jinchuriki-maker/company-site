---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout>
  <section class="text-center py-20">
    <h1 class="text-5xl font-bold mb-4">Your Company Name</h1>
    <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
      We provide amazing services that help businesses grow and succeed in the digital world.
    </p>
    <a href="/contact" class="inline-block bg-blue-600 text-white px-8 py-3 rounded-lg text-lg hover:bg-blue-700">
      Get In Touch
    </a>
  </section>

  <section class="grid md:grid-cols-3 gap-8 py-12">
    <div class="border rounded-lg p-6 text-center">
      <div class="text-4xl mb-3">&#x1F680;</div>
      <h3 class="text-xl font-semibold mb-2">Fast Service</h3>
      <p class="text-gray-600">Quick turnaround times without compromising quality.</p>
    </div>
    <div class="border rounded-lg p-6 text-center">
      <div class="text-4xl mb-3">&#x1F4A1;</div>
      <h3 class="text-xl font-semibold mb-2">Innovation</h3>
      <p class="text-gray-600">Cutting-edge solutions tailored to your needs.</p>
    </div>
    <div class="border rounded-lg p-6 text-center">
      <div class="text-4xl mb-3">&#x1F91D;</div>
      <h3 class="text-xl font-semibold mb-2">Support</h3>
      <p class="text-gray-600">Dedicated assistance whenever you need it.</p>
    </div>
  </section>
</MainLayout>