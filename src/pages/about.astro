---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout>
  <h1 class="text-4xl font-bold mb-6">About Us</h1>
  
  <section class="max-w-3xl">
    <p class="text-lg text-gray-700 mb-6">
      We are a passionate team dedicated to delivering exceptional solutions. 
      Founded in 2024, our mission is to help businesses thrive through technology and innovation.
    </p>

    <h2 class="text-2xl font-semibold mt-10 mb-4">Our Mission</h2>
    <p class="text-gray-700 mb-6">
      To empower businesses with reliable, scalable, and efficient solutions that drive real results.
    </p>

    <h2 class="text-2xl font-semibold mt-10 mb-4">Our Values</h2>
    <ul class="space-y-3 text-gray-700">
      <li>✅ <strong>Integrity</strong> - We do what's right, always.</li>
      <li>✅ <strong>Excellence</strong> - We strive for the highest quality.</li>
      <li>✅ <strong>Innovation</strong> - We embrace new ideas and technology.</li>
      <li>✅ <strong>Customer First</strong> - Your success is our priority.</li>
    </ul>
  </section>
</MainLayout>